agent {
      checkoutSCM()
      
      xmlaccess(
        hostname: 'mock-dx-server.dxclient-test.svc.cluster.local', 
        dxUsername: 'dx-test-username', 
        dxPassword: 'dx-test-password', 
        dxProtocol: 'http', 
        dxPort: '9080', 
        dxclientPath: '/usr/local/lib/node_modules/@hcl-software/dxclient/bin/dxclient',
        disablePrompt: 'true',
        xmlFile: '/tmp/test-config.xml')
      
      deploy_application(
        hostname: 'mock-dx-server.dxclient-test.svc.cluster.local', 
        dxUsername: 'dx-test-username', 
        dxPassword: 'dx-test-password', 
        dxProtocol: 'http', 
        dxPort: '9080', 
        dxclientPath: '/usr/local/lib/node_modules/@hcl-software/dxclient/bin/dxclient',
        disablePrompt: 'true',
        applicationFile: '/tmp/test.ear', 
        applicationName: 'TestApp')
      
      deploy_theme(
        hostname: 'mock-dx-server.dxclient-test.svc.cluster.local', 
        dxUsername: 'dx-test-username', 
        dxPassword: 'dx-test-password', 
        dxProtocol: 'http', 
        dxPort: '9080', 
        dxclientPath: '/usr/local/lib/node_modules/@hcl-software/dxclient/bin/dxclient',
        disablePrompt: 'true',
        themeName: 'TestTheme', 
        themePath: '/tmp/themes/TestTheme')
  }
